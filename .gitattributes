# =======================================================
# 1. CROSS-PLATFORM NORMALIZATION (Win 11 <-> Debian)
# Force LF (Linux style) for all code files.
# Git converts CRLF -> LF on commit, and LF -> CRLF on checkout (Windows).
*.py        text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.sh        text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Keep Windows scripts as CRLF
*.bat       text eol=crlf
*.ps1       text eol=crlf
# 2. GIT LFS (LARGE FILE STORAGE)
# If you force-add a binary file, LFS handles the pointer.
# ML Models
*.pth       filter=lfs diff=lfs merge=lfs -text
*.pt        filter=lfs diff=lfs merge=lfs -text
*.ckpt      filter=lfs diff=lfs merge=lfs -text
*.h5        filter=lfs diff=lfs merge=lfs -text
*.onnx      filter=lfs diff=lfs merge=lfs -text
# Serialization & Compressed Data
*.pkl       filter=lfs diff=lfs merge=lfs -text
*.joblib    filter=lfs diff=lfs merge=lfs -text
*.gz        filter=lfs diff=lfs merge=lfs -text
*.zip       filter=lfs diff=lfs merge=lfs -text
*.parquet   filter=lfs diff=lfs merge=lfs -text
*.arrow     filter=lfs diff=lfs merge=lfs -text
# Specific large files
Drug_Compount_processed.tsv filter=lfs diff=lfs merge=lfs -text
# 3. LINGUIST (GITHUB STATS)
# Exclude data/docs from language statistics
*.json      linguist-generated
docs/* linguist-documentation
*.vcf !text !filter !merge !diff
*.tar.gz !text !filter !merge !diff
