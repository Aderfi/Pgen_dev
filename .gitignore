# =======================================================
# 1. CORE & PYTHON
# =======================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/

# =======================================================
# 2. ENVIRONMENTS & SECRETS (CRITICAL)
# =======================================================
# Virtual Environments
.*env*/

# Credentials & Local Configs
gha-creds-*.json
gemini*.json
src/cfg/venv_setup_true

# =======================================================
# 3. IDE & OS (Windows/Linux Compatibility)
# =======================================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# MacOS (if collaborating)
.DS_Store

# IDEs
.vscode/
.idea/
*.code-workspace
.user_env_cfg

# =======================================================
# 4. BIOINFORMATICS & DATA
# =======================================================
# General Large Data rule: Ignore everything in data/ first
data/*

# Exceptions: explicit folders we DO want to track (structure)
!data/dicts/
!data/processed/.gitkeep
!data/raw/.gitkeep
!data/vcf/.gitkeep

# Specific extensions to block globally (Safety net)
*.vcf
*.vcf.gz
*.tbi
*.bam
*.sam
*.cram
*.fa
*.fasta
*.fa.gz

# Tabular Data (prevent accidental CSV commits)
*.csv
#*.tsv
*.xlsx
#*.parquet
*.feather

# Library dependencies inside src (if applicable)
src/library/**

# =======================================================
# 5. ML ARTIFACTS & MODELS
# =======================================================
*.pth
*.pt
*.pkl
*.h5
*.ckpt
*.onnx
model_*.txt
*.joblib

# Optuna / DBs
*.db
*.sqlite3

# =======================================================
# 6. LOGS & OUTPUTS
# =======================================================
logs/
reports/
cache/
results/
npm-debug.log*
*.log
GEMINI.md