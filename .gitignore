# =======================================================
# 4. BIOINFORMATICS & DATA
# =======================================================
# General Large Data rule: Ignore everything in data/ first
data/*

# Exceptions: explicit folders we DO want to track (structure)
# Must un-ignore the directory itself before contents are reachable.
!data/dicts/
!data/dicts/**
!data/processed/.gitkeep
!data/raw/.gitkeep
!data/vcf/.gitkeep

# Specific extensions to block globally (Safety net)
*.vcf
*.vcf.gz
*.tbi
*.bam
*.sam
*.cram
*.fa
*.fasta
*.fa.gz

# Tabular Data (prevent accidental CSV commits)
*.csv
#*.tsv
*.xlsx
#*.parquet
*.feather

# Library dependencies inside src (if applicable)
src/library/**

