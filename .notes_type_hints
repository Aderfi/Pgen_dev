from collections.abc import Mapping, Sequence, AbstractSet, MutableSequence

def procesar_datos(
    # Acepta dict, pero no lo modifica
    config: Mapping[str, int],  
    
    # Acepta list o tuple (orden importa), no modifica
    nombres_columnas: Sequence[str],  
    
    # Acepta set o frozenset (unicidad importa, orden no), no modifica
    categorias_excluidas: AbstractSet[str],
    
    # Acepta list y NECESITA modificarla (ej. append)
    buffer_salida: MutableSequence[str] 
) -> None:
    
    # Uso de Mapping: Buscar clave
    limite = config.get("max_items", 10) 
    
    # Uso de AbstractSet: Chequeo de pertenencia eficiente O(1)
    # Si fuera Sequence, esto sería O(n)
    filtrados = [col for col in nombres_columnas if col not in categorias_excluidas]
    
    # Uso de MutableSequence: Modificación
    buffer_salida.extend(filtrados)

# Uso
mi_config = {"max_items": 5}
mis_cols = ("col_a", "col_b", "col_c") # Tupla (es Sequence)
mis_excl = {"col_c"}                   # Set (es AbstractSet)
mi_buffer = []                         # Lista (es MutableSequence)

procesar_datos(mi_config, mis_cols, mis_excl, mi_buffer)

